#!/usr/bin/env sh
# Run badgR from its Docker image on an R script, a folder, a package, or a url: ./badgr app/ [options]
# Reports and badges written with --json/--md/--badge land in ./badgr-out next to where you call this.
set -eu
IMAGE="${BADGR_IMAGE:-eagleoutice/badgr:latest}"
if [ $# -lt 1 ]; then
  exec docker run --rm "$IMAGE" --help
fi
target=$1
shift
mkdir -p badgr-out
if [ -d "$target" ]; then
  mount=$(cd "$target" && pwd); arg=/work/src
elif [ -e "$target" ]; then
  mount=$(cd "$(dirname "$target")" && pwd); arg=/work/src/$(basename "$target")
else
  # a url or a package (https://github.com/owner/repo, glue@1.8.0): the image downloads it
  exec docker run --rm --init -u "$(id -u):$(id -g)" \
    -v "$(pwd)/badgr-out:/work/out" -w /work/out \
    "$IMAGE" "$@" "$target"
fi
exec docker run --rm --init -u "$(id -u):$(id -g)" \
  -v "$mount:/work/src:ro" -v "$(pwd)/badgr-out:/work/out" -w /work/out \
  "$IMAGE" "$@" "$arg"
